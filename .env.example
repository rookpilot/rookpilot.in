# Copy to .env.local and fill in. .env.local is never committed.

# Local Supabase (npm run db:start prints both values; npm run db:status shows them again).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted project: Supabase dashboard → Connect. Only use these to test against the real project.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google sign-in for local Supabase (Google Cloud → Clients → Rookpilot web).
# No NEXT_PUBLIC_ prefix: only the local Supabase reads these, never the browser.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Agent (lib/agent): console.anthropic.com → API Keys. npm run agent:graph reads it from .env.local.
# Server-only: never prefix these with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Where chats are saved (the agent schema). Local: npm run db:status shows the DB URL.
# Hosted: Supabase dashboard → Connect → Transaction pooler (port 6543). Without it, chats are
# kept in memory and lost on restart.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# LangSmith tracing: see each graph run and Claude call at smith.langchain.com.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=rookpilot-dev
