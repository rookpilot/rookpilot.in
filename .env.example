# Copy to .env.local and fill in. .env.local is never committed.

# Local Supabase (npm run db:start prints both values; npm run db:status shows them again).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted project: Supabase dashboard → Connect. Only use these to test against the real project.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
